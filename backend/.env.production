# Database (production DB)
DATABASE_URL=postgresql://<prod_user>:<prod_password>@<prod_host>:5432/vasenvolt
DATABASE_TEST_URL=postgresql://<prod_user>:<prod_password>@<prod_host>:5432/vasenvolt_test

# Security
SECRET_KEY=your-very-strong-prod-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (production)
REDIS_URL=redis://<prod_redis_host>:6379

# Frontend
FRONTEND_URL=https://yourdomain.com

# Extra required fields
ALLOWED_ORIGINS=https://yourdomain.com
ENVIRONMENT=production
DEBUG=false
