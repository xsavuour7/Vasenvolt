# Enforce exact versions for all dependencies
save-exact=true

# Use the latest npm
engine-strict=true

# Use package-lock.json
package-lock=true

# Use npm's cache
cache-min=9999999

# Set registry to npm's official registry
registry=https://registry.npmjs.org/

# Set strict SSL
strict-ssl=true

# Set maximum number of concurrent connections
maxsockets=50

# Set network timeout
fetch-timeout=60000

# Set network retry count
fetch-retries=3

# Set network retry factor
fetch-retry-factor=2

# Set network retry mintimeout
fetch-retry-mintimeout=10000

# Set network retry maxtimeout
fetch-retry-maxtimeout=60000 